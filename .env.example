# ==============================================================================
# CodeAtlas AI Environment Configuration Template
# Copy this file to '.env' and populate with your local values.
# ==============================================================================

# --- System Environment ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-cryptographically-secure-key-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configurations ---
# Connection string format for primary PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeatlas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Caching and Task Queue Broker ---
# Redis server connection string
REDIS_URL=redis://localhost:6379/0

# --- Ingestion & Storage Settings ---
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB limit

# --- AI Gateway & LLM Provider API Keys ---
# Google Gemini (Default provider for structured analysis and extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Optional provider for complex planning tasks)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (Optional fallback provider)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Endpoint (For offline local execution tests)
OLLAMA_HOST=http://localhost:11434

# --- Prompt Registry configurations ---
PROMPT_CACHE_TTL_SECONDS=3600

# --- Feature Flag Overrides (JSON formatted overrides for testing)
FEATURE_FLAG_OVERRIDES={}

# --- Telemetry & Evaluation Logs ---
ENABLE_EVALUATION_LOGS=true
TELEMETRY_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
