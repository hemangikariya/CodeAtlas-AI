ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-cryptographically-secure-key-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeatlas
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codeatlas
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=104857600
PROMPT_CACHE_TTL_SECONDS=3600
FEATURE_FLAG_OVERRIDES={}
ENABLE_EVALUATION_LOGS=true
TELEMETRY_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]
