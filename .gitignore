# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent conflicts.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you choose to not use lock files, specify here:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be tracked.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be tracked.
#pdm.lock

# virtualenv
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

